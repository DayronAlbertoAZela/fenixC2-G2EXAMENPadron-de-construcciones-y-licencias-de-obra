<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="miContenedor" prefHeight="520.0" prefWidth="1150.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.syslicencias.controller.LicenciaObraController">
  <children>
    <VBox spacing="8.0" AnchorPane.topAnchor="8.0" AnchorPane.leftAnchor="8.0"
          AnchorPane.rightAnchor="8.0" AnchorPane.bottomAnchor="8.0">
      <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
          <children>
            <Label text="Padron de Licencias de Obra">
              <font><Font name="System Bold" size="18.0"/></font>
            </Label>
            <Label text="Buscar:"/>
            <TextField fx:id="txtFiltroDato" prefWidth="260.0"
                       promptText="N. licencia, propietario, direccion o tipo"/>
          </children>
        </HBox>
        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
          <children>
            <GridPane hgap="6.0" vgap="8.0" prefWidth="400.0">
              <columnConstraints>
                <ColumnConstraints prefWidth="130.0"/>
                <ColumnConstraints prefWidth="260.0"/>
              </columnConstraints>
              <children>
                <Label text="Formulario de Registro" GridPane.columnSpan="2">
                  <font><Font name="System Bold" size="13.0"/></font>
                </Label>
                <Label text="N. Licencia" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNumeroLicencia" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Tipo de Obra" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cbxTipoObra" maxWidth="1.7976931348623157E308"
                          GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Direccion" GridPane.rowIndex="3"/>
                <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Propietario" GridPane.rowIndex="4"/>
                <TextField fx:id="txtPropietario" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Fecha Inicio" GridPane.rowIndex="5"/>
                <DatePicker fx:id="dpFechaInicio" maxWidth="1.7976931348623157E308"
                            GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Fecha Fin Prevista" GridPane.rowIndex="6"/>
                <DatePicker fx:id="dpFechaFin" maxWidth="1.7976931348623157E308"
                            GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                  <children>
                    <Button text="Guardar" onAction="#validarFormulario"
                            styleClass="btn, btn-primary"/>
                    <Button text="Cancelar" onAction="#clearForm"
                            styleClass="btn, btn-danger"/>
                  </children>
                </HBox>
                <Label fx:id="lbnMsg" text="" wrapText="true"
                       GridPane.columnSpan="2" GridPane.rowIndex="8"/>
              </children>
            </GridPane>
            <TableView fx:id="tableView" HBox.hgrow="ALWAYS"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</AnchorPane>
